{
	"name": "FlowTest",
	"properties": {
		"activities": [
			{
				"name": "CorrelationID",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "correlationID",
					"value": {
						"value": "@guid()",
						"type": "Expression"
					}
				}
			},
			{
				"name": "IncomingFile",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "CorrelationID",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "ExcelSource",
						"storeSettings": {
							"type": "AzureBlobStorageReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						}
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobStorageWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "DSInFile",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "DSOutFile",
						"type": "DatasetReference"
					}
				]
			},
			{
				"name": "GetMetadata",
				"type": "GetMetadata",
				"dependsOn": [
					{
						"activity": "IncomingFile",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "DSOutFile",
						"type": "DatasetReference"
					},
					"fieldList": [
						"exists",
						"columnCount",
						"structure"
					],
					"storeSettings": {
						"type": "AzureBlobStorageReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "Stage1_Check",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "GetMetadata",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@and(\n    and(\n        contains(string(activity('GetMetadata').output.structure), 'EmployeeID'),\n        contains(string(activity('GetMetadata').output.structure), 'FirstName')\n    ),\n    contains(string(activity('GetMetadata').output.structure), 'Email')\n)",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Fail",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "pipelineReturnValue",
								"value": [
									{
										"key": "failMsg",
										"value": {
											"type": "String",
											"content": "Failed"
										}
									}
								],
								"setSystemVariable": true
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "Success",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "pipelineReturnValue",
								"value": [
									{
										"key": "successMsg",
										"value": {
											"type": "String",
											"content": "Success"
										}
									}
								],
								"setSystemVariable": true
							}
						}
					]
				}
			}
		],
		"variables": {
			"correlationID": {
				"type": "String"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-10-25T09:51:33Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}